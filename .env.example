# Optional. Copy to .env only on your own machine. Never commit or upload .env.
# Existing environment variables take precedence. A key is required for Jev cellular decisions; blank allows tissue inspection only.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_BATCH_SIZE=20
JEV_MAX_ATTEMPTS=3
JEV_TIMEOUT_SECONDS=10
JEV_MAX_SESSION_CALLS=600
